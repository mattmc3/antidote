#!/usr/bin/env zsh
# Bench setup for zgenom.
#
# `zgenom save` bakes the loads into an init.zsh, so timed runs read a static
# file the way antidote does. The post-load keybind hook sits outside the
# guard so it fires every startup like the other managers.
emulate -L zsh
setopt err_return

: ${BENCH_HOME:?not set}

if [[ ! -f $BENCH_HOME/.zgenom/zgenom.zsh ]]; then
  rm -rf $BENCH_HOME/.zgenom
  git clone --quiet --depth 1 https://github.com/jandamm/zgenom.git \
    $BENCH_HOME/.zgenom
fi

cp -r -- ${0:A:h}/skel/*(D) $BENCH_HOME/
