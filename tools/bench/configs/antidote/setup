#!/usr/bin/env zsh
# Bench setup for antidote, against the working tree rather than a release.
#
# Reads $BENCH_HOME and $BENCH_PRJDIR; populates $BENCH_HOME. The generated
# .zshrc reads $BENCH_PRJDIR, and timed runs use env -i, so .zshenv carries
# the path in rather than the skel file baking it.
emulate -L zsh
setopt err_return

: ${BENCH_HOME:?not set}

cp -r -- ${0:A:h}/skel/*(D) $BENCH_HOME/

>$BENCH_HOME/.zshenv <<EOF
export BENCH_PRJDIR=$BENCH_PRJDIR
EOF
